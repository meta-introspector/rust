{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Usage Data Schema",
  "description": "Schema for validating collected usage data files",
  "type": "object",
  "properties": {
    "crate": {
      "type": "string",
      "description": "Name of the crate"
    },
    "module": {
      "type": "string", 
      "description": "Module name (e.g., 'structs', 'enums', 'functions')"
    },
    "usages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "description": "Kind of usage (e.g., 'struct_decl', 'enum_decl')"
          },
          "node_type": {
            "type": "string",
            "description": "AST node type"
          },
          "symbol": {
            "type": "string",
            "description": "Symbol name"
          },
          "usage_count": {
            "type": "integer",
            "minimum": 0
          },
          "usage_type": {
            "type": "string",
            "enum": ["StructDecl", "EnumDecl", "FunctionCall", "TypeUsage"]
          },
          "used_crate": {
            "type": ["string", "null"],
            "description": "Crate where the symbol is used"
          },
          "used_def_id": {
            "type": "string",
            "description": "Definition ID of the used symbol"
          },
          "user_crate": {
            "type": "string",
            "description": "Crate that uses the symbol"
          },
          "user_def_id": {
            "type": "string",
            "description": "Definition ID of the user"
          }
        },
        "required": ["kind", "node_type", "symbol", "usage_count", "usage_type", "used_def_id", "user_crate", "user_def_id"],
        "additionalProperties": true
      }
    }
  },
  "required": ["crate", "module", "usages"],
  "additionalProperties": false
}
