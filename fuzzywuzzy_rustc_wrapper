use std::env;
use std::process::Command;

fn main() {
    println!("🐻🔧 FUZZYWUZZY RUSTC WRAPPER INTERCEPTING COMPILATION");
    
    let args: Vec<String> = env::args().collect();
    println!("🔍 Intercepted rustc call with {} args", args.len());
    
    // Check if this is a self-compilation
    if env::var("ZOMBIE_SELF_COMPILE").is_ok() {
        println!("🐻🔄 RECURSIVE SELF-COMPILATION DETECTED!");
        println!("🧟‍♂️ Sending compile request to Fuzzywuzzy Bear via P2P...");
        
        // Create P2P compilation request
        let request = format!(r#"{{
            "peer_id": "fuzzywuzzy_wrapper",
            "file_path": "{}",
            "request_id": "recursive_{}",
            "wrapper_args": {:?}
        }}"#, 
            args.get(1).unwrap_or(&"unknown".to_string()),
            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs(),
            args
        );
        
        println!("📤 P2P Request: {}", request);
        
        // For now, fall back to regular rustc but log the interception
        println!("🐻 Bear intercepted his own compilation - RECURSIVE LOOP ACHIEVED!");
    }
    
    // Forward to real rustc
    println!("🔧 Forwarding to real rustc...");
    let mut cmd = Command::new("rustc");
    cmd.args(&args[1..]);
    
    match cmd.status() {
        Ok(status) => {
            println!("🐻✅ Rustc wrapper completed with status: {}", status);
            std::process::exit(status.code().unwrap_or(0));
        }
        Err(e) => {
            println!("🐻❌ Rustc wrapper error: {}", e);
            std::process::exit(1);
        }
    }
}
